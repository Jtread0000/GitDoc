# GitDoc — environment reference for the Dropbox sync.
#
# IMPORTANT: most of these are NOT a local .env file. The sync runs in GitHub
# Actions (.github/workflows/sync-to-dropbox.yml), so the values live in your
# GitHub repo, not on disk. This file is a checklist of WHAT to set and WHERE.
# Full walkthrough with screenshots of the flow: docs/setup-dropbox.md.
#
# ── GitHub repository SECRETS ────────────────────────────────────────────────
#   Repo → Settings → Secrets and variables → Actions → Secrets → New repository secret
#   Secret — never commit real values.
DROPBOX_APP_KEY=            # Dropbox app key            (Dropbox app → Settings)
DROPBOX_APP_SECRET=         # Dropbox app secret         (Dropbox app → Settings)
DROPBOX_REFRESH_TOKEN=      # offline refresh token      (docs/setup-dropbox.md, step 2)
#
# ── GitHub repository VARIABLES ──────────────────────────────────────────────
#   Repo → Settings → Secrets and variables → Actions → Variables → New repository variable
#   Not secret — plain config.
DROPBOX_DEST_DIR=/Research/MyProject   # Dropbox folder to sync into. Use a NEW subfolder per project.
SYNC_FILES=                            # optional. Comma/space-separated files. Default: every *.docx in the repo root.
#
# ── Optional: LOCAL runs only ────────────────────────────────────────────────
# You only need these on your own machine if you run scripts/dropbox_sync.py by
# hand (the GitHub Action doesn't use a local file). Export the three secrets above
# in your shell, or put them in a local `.env` that you DO NOT commit — `.env` is
# gitignored for exactly this reason.
